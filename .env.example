# ---------------------------------------------------------------------------
# Poker Bankroll Pro configuration. Copy to .env.local and fill in.
# Everything here is SERVER-ONLY except variables prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Database the Next.js server connects to. Locally this is the `pbp_app` role,
# which can only act through the RLS-restricted `authenticated` role.
# On Supabase use the pooled connection string (Settings > Database), e.g.
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://pbp_app:change-me-app-password@localhost:5432/poker_bankroll

# Connection with schema-owner rights, used ONLY by `pnpm db:migrate`.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/poker_bankroll

# true = plain local PostgreSQL: create the Supabase auth/roles shim.
# MUST be false (or unset) for a real Supabase project.
DB_LOCAL_SHIM=true
LOCAL_APP_DB_PASSWORD=change-me-app-password

# Auth provider: "local" (built-in password login, sessions stored in Postgres)
# or "supabase" (Supabase Auth; requires the two NEXT_PUBLIC_SUPABASE_* values).
AUTH_PROVIDER=local

# Public self-registration is disabled by default (private, single-user app).
# Create the owner account with `pnpm user:create you@example.com`.
ALLOW_SIGNUP=false

# Supabase (only when AUTH_PROVIDER=supabase / STORAGE_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for private attachment storage and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Attachment storage: "local" (files under ATTACHMENTS_DIR, served only to
# their owner) or "supabase" (private bucket named in SUPABASE_BUCKET).
STORAGE_PROVIDER=local
ATTACHMENTS_DIR=.data/attachments
SUPABASE_BUCKET=attachments
